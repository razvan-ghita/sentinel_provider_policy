import "tfconfig/v2" as tfconfig
import "strings"

# ---------------------------------------------------------------------------
# AWS Provider Version Constraint Check (permissive — no-constraint allowed)
#
# Behaviour:
#   - No version constraint declared → PASS (defers to tfpolicy for real
#     version enforcement via meta.version)
#   - Constraint declared and within >= 5.x, < 6.0 → PASS
#   - Constraint declared but outside range → BLOCK
#
# ⚠️  This policy does NOT catch a missing constraint + non-compliant provider.
#     Pair with enforce-approved-aws-provider.policy.hcl (tfpolicy) which reads
#     the real resolved version from .terraform.lock.hcl regardless of whether
#     a constraint is declared.
# ---------------------------------------------------------------------------

providers     = tfconfig.providers else {}
aws_providers = filter providers as addr, p {
    p.source else "" is "registry.terraform.io/hashicorp/aws"
}

is_gte_5 = func(constraint) {
    return strings.has_prefix(constraint, "~> 5") or
           strings.has_prefix(constraint, ">= 5")
}

is_lt_6 = func(constraint) {
    # ~> 5.x is implicitly < 6.0 — safe
    if strings.has_prefix(constraint, "~> 5") {
        return true
    }
    # Explicit < 6.0.0 or < 6 present in the constraint string
    if strings.contains(constraint, "< 6") {
        return true
    }
    return false
}

main = rule {
    all aws_providers as _, p {
        constraint = p.version_constraint else null
        print("AWS provider source:", p.source else "unknown",
              "| version_constraint:", constraint else "none (no constraint declared — tfpolicy enforces real version)")

        # No constraint declared → pass, tfpolicy handles real version check
        constraint is null or
        (
            is_gte_5(constraint) and
            is_lt_6(constraint)
        )
    }
}
